// Cloudflare Worker: public bridge with scoped text editing for the Processos project subtree.
// Store a NEW token as the Cloudflare secret NOTION_API_TOKEN.
const PROJECT_ID = '5944bb6f807682be992e01c9e7c67a8b';
const PAGE_ID = '7bd4bb6f807683648a83810c94d10a90';
const SOURCE_ID = '4b94bb6f807683dd8e3c01eb363d001d';
const API_VERSION = '2026-03-11';
const canonical = value => String(value || '').replaceAll('-', '').toLowerCase();
const plain = block => (block[block.type]?.rich_text || []).map(t => t.plain_text ?? t.text?.content ?? '').join('');
const overview = block => block.type === 'paragraph' && /^visao geral(?:\s|\(|$)/.test(plain(block).normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim().toLowerCase());
class BridgeError extends Error { constructor(status, code, message) { super(message); this.status = status; this.code = code; } }
const wait = ms => new Promise(resolve => setTimeout(resolve, ms));
function response(body, status = 200) {
 return new Response(JSON.stringify(body), { status, headers: {
  'Content-Type': 'application/json; charset=utf-8',
  'Access-Control-Allow-Origin': '*', // This read-only output is intentionally link-public.
  'Access-Control-Allow-Methods': 'GET, PATCH, OPTIONS',
  'Access-Control-Allow-Headers': 'Content-Type',
  'Cache-Control': 'no-store', 'X-Content-Type-Options': 'nosniff',
  'Content-Security-Policy': "default-src 'none'; frame-ancestors 'none'",
  'Referrer-Policy': 'no-referrer'
 }});
}
function makeNotion(token, fetcher) {
 let calls = 0, previous = 0;
 return async (path, options = {}) => {
  for (let attempt = 0; attempt < 3; attempt++) {
   if (++calls > 160) throw new BridgeError(422, 'CONTENT_LIMIT', 'A aba ultrapassou o limite de leitura do teste. Nenhum conteúdo parcial foi publicado.');
   const delay = Math.max(0, previous + 360 - Date.now());
   if (delay) await wait(delay);
   previous = Date.now();
   const r = await fetcher(`https://api.notion.com/v1/${path}`, {
    method: options.method || 'GET', headers: { Authorization: `Bearer ${token}`, 'Notion-Version': API_VERSION, 'Content-Type':'application/json' },
    ...(options.body ? {body:JSON.stringify(options.body)} : {}),
    signal: AbortSignal.timeout(15000)
   });
   if (r.status === 429 && attempt < 2) {
    await wait(Math.min(10000, Math.max(1000, Number(r.headers.get('Retry-After') || 1) * 1000))); continue;
   }
   if (!r.ok) {
    const messages = {401:'O segredo da conexão é inválido. Configure um token novo.',403:options.method === 'PATCH' ? 'A conexão precisa da permissão Atualizar conteúdo no Notion.' : 'A conexão não tem permissão de leitura.',404:'A fonte não foi encontrada ou não foi compartilhada com a conexão.',429:'Limite temporário da API. Tente novamente em alguns instantes.'};
    throw new BridgeError(r.status === 429 ? 429 : 502, `NOTION_${r.status}`, messages[r.status] || 'Não foi possível consultar o Notion.');
   }
   return r.json();
  }
 };
}
async function listAll(id, api) {
 const items = []; let cursor;
 do {
  const page = await api(`blocks/${encodeURIComponent(id)}/children?page_size=100${cursor ? `&start_cursor=${encodeURIComponent(cursor)}` : ''}`);
  items.push(...page.results);
  if (items.length > 5000) throw new BridgeError(422,'CONTENT_LIMIT','A fonte excede o limite deste teste.');
  cursor = page.has_more ? page.next_cursor : null;
  if (page.has_more && !cursor) throw new BridgeError(502,'PAGINATION_ERROR','A API retornou paginação incompleta.');
 } while (cursor);
 return items;
}
async function verifyProject(block, api) {
 let node = block;
 for (let depth = 0; depth < 40; depth++) {
  if (canonical(node.id) === PROJECT_ID) return;
  const parent = node.parent;
  const routes = {page_id:'pages',block_id:'blocks',database_id:'databases',data_source_id:'data_sources'};
  if (!parent || !routes[parent.type]) break;
  const parentId = parent[parent.type];
  if (parent.type === 'page_id' && canonical(parentId) === PROJECT_ID) return;
  node = await api(`${routes[parent.type]}/${encodeURIComponent(parentId)}`);
 }
 throw new BridgeError(403,'OUTSIDE_PROJECT','Este recurso não pertence ao projeto Processos - Guilherme autorizado.');
}
async function contentTree(id, api, depth = 0, budget = {total:0}) {
 if (depth > 20) throw new BridgeError(422,'CONTENT_DEPTH','O conteúdo é muito profundo para uma única leitura.');
 const output = [];
 for (const block of await listAll(id, api)) {
  if (++budget.total > 5000) throw new BridgeError(422,'CONTENT_LIMIT','O conteúdo excede o limite por requisição. Leia as seções separadamente.');
  const item = {id:block.id,type:block.type,last_edited_time:block.last_edited_time,content:block[block.type] || {}};
  // Keep references as navigation targets. Never automatically crawl an entire project or external synced source.
  if (['child_page','child_database','link_to_page','synced_block','unsupported'].includes(block.type)) {
   item.reference_only = true;
  } else if (block.has_children) item.children = await contentTree(block.id,api,depth+1,budget);
  output.push(item);
 }
 return output;
}
function metadata(node) {
 return Object.fromEntries(['object','id','url','last_edited_time','title','properties','data_sources','icon','cover','description'].filter(k=>node[k]!==undefined).map(k=>[k,node[k]]));
}
async function genericRead(path, search, api) {
 if (path === '/api/project') path = `/api/pages/${PROJECT_ID}`;
 const match = path.match(/^\/api\/(pages|blocks|databases|data-sources)\/([a-f0-9-]+)(\/pages)?$/i);
 if (!match || !/^[a-f0-9]{32}$/.test(canonical(match[2]))) throw new BridgeError(404,'NOT_FOUND','Rota não encontrada.');
 const kind=match[1], id=canonical(match[2]), queryPages=Boolean(match[3]);
 if(queryPages && kind!=='data-sources') throw new BridgeError(404,'NOT_FOUND','Rota não encontrada.');
 if([...search.keys()].some(key=>key!=='cursor') || (!queryPages && search.size)) throw new BridgeError(400,'INVALID_QUERY','Parâmetros não suportados.');
 const route=kind==='data-sources'?'data_sources':kind;
 const node=await api(`${route}/${id}`);
 await verifyProject(node,api);
 if(queryPages) {
  const cursor=search.get('cursor');
  if(cursor && (cursor.length>256 || !/^[a-z0-9-]+$/i.test(cursor))) throw new BridgeError(400,'INVALID_CURSOR','Cursor inválido.');
  const result=await api(`data_sources/${id}/query`,{method:'POST',body:{page_size:100,...(cursor?{start_cursor:cursor}:{})}});
  return {ok:true,project_id:PROJECT_ID,read_only:true,results:result.results.map(metadata),has_more:result.has_more,next_cursor:result.next_cursor,request_status:result.request_status,fetched_at:new Date().toISOString()};
 }
 const result={ok:true,project_id:PROJECT_ID,read_only:true,resource:metadata(node),fetched_at:new Date().toISOString()};
 if(kind==='pages' || kind==='blocks') result.blocks=await contentTree(id,api);
 return result;
}
async function getOverview(api) {
 const source = await api(`blocks/${SOURCE_ID}`);
 await verifyProject(source, api);
 let tab = source;
 if (source.type === 'tab') {
  const matches = (await listAll(source.id, api)).filter(overview);
  if (matches.length !== 1) throw new BridgeError(422,'OVERVIEW_NOT_UNIQUE','Não foi possível identificar uma única aba Visão geral nesse bloco.');
  tab = matches[0];
 }
 if (!overview(tab)) throw new BridgeError(422,'SOURCE_MISMATCH','O bloco indicado não é a aba Visão geral nem seu contêiner de abas. Confira o link do bloco.');
 const blocks = await contentTree(tab.id, api);
 await stampRevisions(blocks);
 return { ok:true, section:'visao-geral', title:plain(tab), page_id:PAGE_ID, source_block_id:canonical(tab.id),
  fetched_at:new Date().toISOString(), read_only:false, public_editing:true, edit_scope:'visao-geral', blocks };
}
// Public editing is deliberately restricted to existing text blocks inside Visao geral.
const EDIT_TYPES = new Set(['paragraph','heading_1','heading_2','heading_3','heading_4','bulleted_list_item','numbered_list_item','quote','callout','to_do','toggle']);
const EDIT_COLORS = new Set(['default',...['gray','brown','orange','yellow','green','blue','purple','pink','red'].flatMap(c=>[c,c+'_background'])]);
async function revisionOf(block) {
 const bytes=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(JSON.stringify({type:block.type,rich_text:block.content?.rich_text ?? block[block.type]?.rich_text ?? []})));
 return [...new Uint8Array(bytes)].map(b=>b.toString(16).padStart(2,'0')).join('');
}
async function stampRevisions(blocks) {
 for(const block of blocks){
  if(EDIT_TYPES.has(block.type) && (block.content?.rich_text||[]).every(t=>t.type==='text'))block.revision=await revisionOf(block);
  await stampRevisions(block.children||[]);
 }
}
function validateRichText(value) {
 if(!Array.isArray(value)||value.length>100)throw new BridgeError(400,'INVALID_TEXT','Texto inválido ou com formatação excessiva.');
 let size=0;
 return value.map(item=>{
  if(item?.type!=='text'||typeof item.text?.content!=='string'||item.text.content.length>2000)throw new BridgeError(400,'INVALID_TEXT','Cada trecho de texto deve ter até 2.000 caracteres.');
  const content=item.text.content;size+=content.length;
  if(size>40000)throw new BridgeError(413,'TEXT_LIMIT','Um dos blocos ultrapassou o limite de 40 mil caracteres.');
  const text={content};
  if(item.text.link!=null){let url;try{url=new URL(item.text.link.url)}catch{throw new BridgeError(400,'INVALID_LINK','Link inválido.')}
   if(!['https:','http:','mailto:','tel:'].includes(url.protocol)||url.href.length>2000)throw new BridgeError(400,'INVALID_LINK','Link não permitido.');text.link={url:url.href};
  }
  const annotations={};
  for(const key of ['bold','italic','strikethrough','underline','code']){if(item.annotations?.[key]!==undefined){if(typeof item.annotations[key]!=='boolean')throw new BridgeError(400,'INVALID_TEXT','Formatação inválida.');annotations[key]=item.annotations[key]}}
  const color=item.annotations?.color;if(color!==undefined){if(!EDIT_COLORS.has(color))throw new BridgeError(400,'INVALID_TEXT','Cor inválida.');annotations.color=color}
  return {type:'text',text,...(Object.keys(annotations).length?{annotations}:{})};
 });
}
async function boundedJson(request) {
 if(!/^application\/json(?:;|$)/i.test(request.headers.get('Content-Type')||''))throw new BridgeError(415,'JSON_REQUIRED','Use uma solicitação JSON.');
 const reader=request.body?.getReader();if(!reader)throw new BridgeError(400,'INVALID_BODY','Alterações não recebidas.');
 let size=0;const chunks=[];
 try{for(;;){const part=await reader.read();if(part.done)break;size+=part.value.length;if(size>250000){await reader.cancel();throw new BridgeError(413,'REQUEST_LIMIT','Salve menos texto por vez.')}chunks.push(part.value)}}finally{reader.releaseLock()}
 const all=new Uint8Array(size);let offset=0;for(const chunk of chunks){all.set(chunk,offset);offset+=chunk.length}
 try{return JSON.parse(new TextDecoder().decode(all))}catch{throw new BridgeError(400,'INVALID_JSON','Solicitação JSON inválida.')}
}
async function updateOverview(request,api,env) {
 if(env.PUBLIC_EDITING_DISABLED==='true')throw new BridgeError(403,'EDITING_DISABLED','A edição pública foi desativada.');
 const body=await boundedJson(request);
 if(!Array.isArray(body?.changes)||!body.changes.length||body.changes.length>5)throw new BridgeError(400,'CHANGE_LIMIT','Envie de 1 a 5 alterações por etapa.');
 const changes=body.changes.map(change=>{
  const id=canonical(change?.id);
  if(!/^[a-f0-9]{32}$/.test(id)||!/^[a-f0-9]{64}$/.test(change?.revision||''))throw new BridgeError(400,'INVALID_CHANGE','Identificação ou versão do bloco inválida.');
  if(Object.keys(change).some(k=>!['id','revision','rich_text'].includes(k)))throw new BridgeError(400,'INVALID_CHANGE','Somente o texto existente pode ser editado.');
  return {id,revision:change.revision,rich_text:validateRichText(change.rich_text)};
 });
 if(new Set(changes.map(c=>c.id)).size!==changes.length)throw new BridgeError(400,'DUPLICATE_BLOCK','Um bloco foi enviado duas vezes.');
 const source=await getOverview(api);const allowed=new Map();
 function collect(blocks){for(const block of blocks){allowed.set(canonical(block.id),block);collect(block.children||[])}}collect(source.blocks);
 // Validate the complete request before writing any block.
 for(const change of changes){const original=allowed.get(change.id);
  if(!original||!EDIT_TYPES.has(original.type)||(original.content?.rich_text||[]).some(t=>t.type!=='text'))throw new BridgeError(403,'OUTSIDE_EDIT_SCOPE','A edição está limitada aos textos da Visão geral.');
  if(await revisionOf(original)!==change.revision)throw new BridgeError(409,'EDIT_CONFLICT','O texto foi alterado por outra pessoa. Seu rascunho foi mantido; copie-o antes de recarregar.');
 }
 const applied=[];
 for(const change of changes){try{
  const block=await api(`blocks/${change.id}`);
  if(block.in_trash||block.archived)throw new BridgeError(409,'EDIT_CONFLICT','Um dos blocos não está mais disponível.');
  // Recheck ancestry immediately before each write, including moved blocks.
  let parent=block.parent,found=false;
  for(let depth=0;depth<25&&parent?.type==='block_id';depth++){
   if(canonical(parent.block_id)===SOURCE_ID||canonical(parent.block_id)===canonical(source.source_block_id)){found=true;break}
   const ancestor=await api(`blocks/${canonical(parent.block_id)}`);parent=ancestor.parent;
  }
  if(!found)throw new BridgeError(403,'OUTSIDE_EDIT_SCOPE','Um dos blocos foi movido para fora da Visão geral.');
  if(block.type!==allowed.get(change.id).type||await revisionOf(block)!==change.revision)throw new BridgeError(409,'EDIT_CONFLICT','Outra pessoa modificou o texto durante o salvamento. Seu rascunho foi mantido.');
  const updated=await api(`blocks/${change.id}`,{method:'PATCH',body:{[block.type]:{rich_text:change.rich_text}}});
  applied.push({id:canonical(updated.id),type:updated.type,rich_text:updated[updated.type]?.rich_text||[],revision:await revisionOf(updated),last_edited_time:updated.last_edited_time});
 }catch(error){return response({ok:false,code:error.code||'SAVE_ERROR',message:error instanceof BridgeError?error.message:'Falha ao salvar. Seu rascunho foi mantido.',applied,failed_id:change.id},error.status||502)}}
 return response({ok:true,applied,public_editing:true,saved_at:new Date().toISOString()});
}

export function createHandler(fetcher = globalThis.fetch) {
 return async (request, env) => {
  const url = new URL(request.url);
  if (request.method === 'OPTIONS') return response({ok:true});
  if (request.method === 'PATCH' && url.pathname === '/api/visao-geral' && !url.search) {
   if(!env.NOTION_API_TOKEN)return response({ok:false,code:'NOT_CONFIGURED',message:'Configure o secret NOTION_API_TOKEN.'},503);
   try{return await updateOverview(request,makeNotion(env.NOTION_API_TOKEN,fetcher),env)}catch(error){return response({ok:false,code:error.code||'SAVE_ERROR',message:error instanceof BridgeError?error.message:'Falha ao salvar. Seu rascunho foi mantido.',applied:[]},error.status||502)}
  }
  if (request.method !== 'GET') return response({ok:false,code:'METHOD_NOT_ALLOWED',message:'Alteração permitida somente nos textos da Visão geral.'},405);
  if (url.pathname === '/' || url.pathname === '/site') return new Response(SITE_HTML, {headers: {
   'Content-Type':'text/html; charset=utf-8',
   'Cache-Control':'no-store',
   'X-Content-Type-Options':'nosniff',
   'Referrer-Policy':'no-referrer',
   'Content-Security-Policy':"default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'"
  }});
  if (url.pathname === '/health') return response({ok:true,service:'site-processos',configured:Boolean(env.NOTION_API_TOKEN),read_only:env.PUBLIC_EDITING_DISABLED==='true',public_editing:env.PUBLIC_EDITING_DISABLED!=='true',edit_scope:'visao-geral'});
  if (!url.pathname.startsWith('/api/')) return response({ok:false,code:'NOT_FOUND',message:'Rota não encontrada.'},404);
  if(url.pathname==='/api/visao-geral' && url.search) return response({ok:false,code:'FIXED_SOURCE',message:'A rota Visão geral usa uma fonte fixa.'},400);
  if (!env.NOTION_API_TOKEN) return response({ok:false,code:'NOT_CONFIGURED',message:'Configure NOTION_API_TOKEN como Secret no Cloudflare Worker.'},503);
  try {
   const api=makeNotion(env.NOTION_API_TOKEN, fetcher);
   const data = url.pathname==='/api/visao-geral' ? await getOverview(api) : await genericRead(url.pathname,url.searchParams,api);
   if(url.pathname==='/api/visao-geral' && env.PUBLIC_EDITING_DISABLED==='true'){data.read_only=true;data.public_editing=false;}
   const text = JSON.stringify(data);
   if (new TextEncoder().encode(text).byteLength > 2_000_000) throw new BridgeError(422,'CONTENT_LIMIT','A resposta excede o limite do teste.');
   return response(data);
  } catch (error) {
   if (error instanceof BridgeError) return response({ok:false,code:error.code,message:error.message},error.status);
   return response({ok:false,code:'UPSTREAM_ERROR',message:'Falha temporária na leitura do Notion. Tente novamente.'},502);
  }
 };
}
export default { fetch: createHandler() };
